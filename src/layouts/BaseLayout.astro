---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import WorkspaceTools from "../components/WorkspaceTools.astro";
import legacyScript from "../../public/script.js?raw";
import { evidenceMarkup } from "../lib/evidence-copy.mjs";
import { firstPaintScript } from "../lib/first-paint.mjs";
import { motionCheckScript } from "../lib/motion-check.mjs";

interface Props {
  title: string;
  description: string;
  lang?: string;
  page?: string;
  bodyClass?: string;
  legacyI18n?: boolean;
  writingManifest?: { category: string; tags: string[]; searchText: string }[];
  localizedMeta?: Record<"zh" | "en", { title: string; description: string }>;
  pageType?: "website" | "article";
  canonical?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  lang = "en",
  page = "content",
  bodyClass,
  legacyI18n = false,
  writingManifest = [],
  localizedMeta,
  pageType = "website",
  canonical = true,
  noindex = false
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://www.alpacaxu.cn");
const renderedContent = await Astro.slots.render("default");
const pageContent = legacyI18n ? evidenceMarkup(legacyScript, renderedContent) : renderedContent;
const bootstrap = firstPaintScript({ writingManifest });
const motionCheck = motionCheckScript();
---

<!doctype html>
<html lang={lang} data-page={page} data-content-lang={lang} data-page-title-zh={localizedMeta?.zh.title} data-page-title-en={localizedMeta?.en.title}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Opt in before streamed HTML can finish; do not wait for an external stylesheet. -->
    <style is:inline id="page-transition-policy">
      @view-transition { navigation: auto; }
      @media (prefers-reduced-motion: reduce) {
        @view-transition { navigation: none; }
      }
    </style>
    <meta name="description" content={description} data-localized-zh={localizedMeta?.zh.description} data-localized-en={localizedMeta?.en.description} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} data-localized-zh={localizedMeta?.zh.title} data-localized-en={localizedMeta?.en.title} />
    <meta property="og:description" content={description} data-localized-zh={localizedMeta?.zh.description} data-localized-en={localizedMeta?.en.description} />
    {canonical && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />
    <script is:inline set:html={motionCheck}></script>
    <script is:inline set:html={bootstrap}></script>
    <!-- Capture a complete main, not an early streamed header/background frame. -->
    <link rel="expect" blocking="render" href="#page-content-ready" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="modulepreload" href="/workspace.js" />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/astro.css" />
    <link rel="stylesheet" href="/workspace.css" />
    <link rel="stylesheet" href="/pointer-effects.css" />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <SiteHeader />
    <Fragment set:html={pageContent} />
    <span id="page-content-ready" hidden aria-hidden="true"></span>
    <SiteFooter />
    <WorkspaceTools />
    <aside id="motion-check-panel" class="motion-check-panel" hidden aria-label="Transition diagnostics">
      <p data-motion-check-status role="status" aria-live="polite"></p>
      <p data-motion-check-detail></p>
      <button type="button" data-motion-check-close>Close diagnostics</button>
    </aside>
    <script is:inline>
      const root = document.documentElement;
      const storageKey = "alpaca-theme";
      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = nextTheme;
        try { localStorage.setItem(storageKey, nextTheme); } catch { /* Theme still changes without storage. */ }
      });
    </script>
    <script type="module" is:inline src="/workspace.js"></script>
    <script type="module" is:inline src="/pointer-effects.js"></script>
    <slot name="body-end" />
  </body>
</html>
