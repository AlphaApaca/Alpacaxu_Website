---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getWritingPosts, categoryLabel } from "../../lib/content";
import { DEFAULT_CATEGORIES, normalizeSearch, writingFilterUrl } from "../../lib/writing.mjs";
import { site } from "../../data/site.mjs";

const posts = await getWritingPosts();
const categories = [...new Set([...DEFAULT_CATEGORIES, ...posts.map((post) => post.category)])];
const uniqueTags = new Map<string, string>();
posts.forEach((post) => post.tags.forEach((tag) => {
  if (!uniqueTags.has(normalizeSearch(tag))) uniqueTags.set(normalizeSearch(tag), tag);
}));
const tags = [...uniqueTags.values()].sort((left, right) => left.localeCompare(right, "zh-CN"));
const newestDatedPost = posts[0];
const localizedMeta = {
  zh: { title: `文章 | ${site.name}`, description: `${site.name} 的学习日志、技术笔记与杂文。按分类、标签和关键词浏览全部文章。` },
  en: { title: `Writing | ${site.name}`, description: `${site.name}'s learning logs, technical notes and personal essays. Browse published writing by category, tag or keyword.` },
};
const categoryCopy: Record<string, { zh: string; en: string }> = {
  "learning-log": { zh: "学习日志", en: "Learning logs" },
  note: { zh: "技术笔记", en: "Technical notes" },
  essay: { zh: "杂文", en: "Personal essays" },
};
const localizedCategory = (category: string) => Object.hasOwn(categoryCopy, category)
  ? categoryCopy[category]
  : { zh: categoryLabel(category), en: categoryLabel(category) };
---

<BaseLayout title={localizedMeta.zh.title} description={localizedMeta.zh.description} localizedMeta={localizedMeta} lang="zh-CN" page="writing" bodyClass="editorial-writing" writingManifest={posts.map(({ category, tags, searchText }) => ({ category, tags, searchText }))}>
  <Fragment slot="head">
    <link rel="stylesheet" href="/writing-editorial.css" />
    <noscript>
      <style is:inline>
        [data-writing-index] [data-writing-enhanced] { display: none !important; }
      </style>
    </noscript>
  </Fragment>
  <main class="section writing-index" data-writing-index data-writing-total={posts.length}>
    <header class="writing-heading">
      <div class="writing-heading-copy">
        <p class="section-kicker" data-workspace-zh="文章 / 私人档案" data-workspace-en="Writing / Personal archive">文章 / 私人档案</p>
        <h1><span data-workspace-zh="记录、整理，" data-workspace-en="Keep notes.">记录、整理，</span><br /><span data-workspace-zh="偶尔想远一点。" data-workspace-en="Let thoughts wander.">偶尔想远一点。</span></h1>
        <p class="section-intro" data-workspace-zh="学习日志、技术笔记，还有一些随想。中英混写，留在同一个地方。" data-workspace-en="Learning logs, technical notes, and the occasional stray thought. Chinese and English, in the same place.">学习日志、技术笔记，还有一些随想。中英混写，留在同一个地方。</p>
      </div>
      <div class="writing-margin" aria-hidden="true">
        <span data-workspace-zh="学习日志" data-workspace-en="Learning logs">学习日志</span>
        <span data-workspace-zh="技术笔记" data-workspace-en="Technical notes">技术笔记</span>
        <span data-workspace-zh="杂文随想" data-workspace-en="Personal essays">杂文随想</span>
        <small data-workspace-zh="理解、记录、回看。" data-workspace-en="Understand. Write. Revisit.">理解、记录、回看。</small>
      </div>
    </header>

    <form class="writing-controls" method="get" action="/writing/" data-writing-enhanced inert>
      <label class="writing-search" for="writingSearch">
        <span><span data-workspace-zh="搜索文章" data-workspace-en="Search writing">搜索文章</span> <small>SEARCH</small></span>
        <input id="writingSearch" name="q" type="search" placeholder="搜索标题、摘要或标签" data-workspace-placeholder-zh="搜索标题、摘要或标签" data-workspace-placeholder-en="Search titles, summaries or tags" autocomplete="off" />
      </label>
      <label class="writing-tag-select" for="writingTag">
        <span><span data-workspace-zh="标签" data-workspace-en="Tag">标签</span> <small>TAG</small></span>
        <select id="writingTag" name="tag">
          <option value="" data-workspace-zh="全部标签" data-workspace-en="All tags">全部标签</option>
          {tags.map((tag) => <option value={tag}>{tag}</option>)}
        </select>
      </label>
      <input type="hidden" name="category" value="" />
      <button class="writing-reset" type="reset" data-workspace-zh="清除筛选" data-workspace-en="Clear filters">清除筛选</button>
    </form>

    <nav class="writing-categories" aria-label="文章分类" data-workspace-aria-zh="文章分类" data-workspace-aria-en="Writing categories" data-writing-enhanced inert>
      <a href="/writing/" data-writing-category="" aria-current="true"><span data-workspace-zh="全部" data-workspace-en="All">全部</span> <span>{posts.length}</span></a>
      {categories.map((category) => (
        <a href={writingFilterUrl({ category })} data-writing-category={category}>
          <span data-workspace-zh={localizedCategory(category).zh} data-workspace-en={localizedCategory(category).en}>{localizedCategory(category).zh}</span> <span>{posts.filter((post) => post.category === category).length}</span>
        </a>
      ))}
    </nav>

    <div class="writing-list-heading">
      <p id="writingResults" role="status" aria-live="polite" aria-atomic="true">共 {posts.length} 篇文章</p>
      <span data-workspace-zh="按文章日期，从新到旧排列" data-workspace-en="Newest first, by article date">按文章日期，从新到旧排列</span>
    </div>
    <noscript><p class="writing-noscript">以下为全部已发布文章。分类、标签和关键词筛选需要启用 JavaScript；文章阅读不受影响。 / All published writing is shown below. Filtering requires JavaScript; reading does not.</p></noscript>

    <div class="post-list writing-entries" id="writingList">
      {posts.map((post) => (
        <article class:list={["post-card", "writing-entry", { "writing-entry-lead": post.url === newestDatedPost?.url }]} data-writing-post data-category={post.category} data-tags={JSON.stringify(post.tags)} data-search={post.searchText}>
          <div class="post-meta">
            <time datetime={post.date}>{post.date}</time>
            <a href={writingFilterUrl({ category: post.category })} data-writing-category={post.category} data-workspace-zh={localizedCategory(post.category).zh} data-workspace-en={localizedCategory(post.category).en}>{localizedCategory(post.category).zh}</a>
          </div>
          <div class="writing-entry-body">
            {post.url === newestDatedPost?.url && <p class="writing-entry-label" data-workspace-zh="最新记录" data-workspace-en="Latest entry">最新记录</p>}
            <h2><a href={post.url} data-astro-prefetch>{post.title}<span class="writing-entry-arrow" aria-hidden="true">↗</span></a></h2>
            <p class="writing-entry-summary">{post.summary}</p>
            <div class="tags">{post.tags.map((tag) => <a href={writingFilterUrl({ tag })} data-writing-tag={tag}>{tag}</a>)}</div>
          </div>
        </article>
      ))}
    </div>
    <div class="writing-empty" id="writingEmpty" hidden>
      <p class="section-kicker" data-workspace-zh="没有匹配的文章" data-workspace-en="No matching entries">没有匹配的文章</p>
      <h2 data-workspace-zh="这里暂时还没有文章。" data-workspace-en="Nothing here just yet.">这里暂时还没有文章。</h2>
      <p id="writingEmptyHint">换个关键词，或清除分类和标签试试。</p>
      <button class="writing-reset" type="button" data-writing-clear data-workspace-zh="查看全部文章" data-workspace-en="View all writing">查看全部文章</button>
    </div>
    <footer class="writing-index-footer">
      <span data-workspace-zh="学习日志来自 repytorch，杂文独立记录。只展示明确发布的文章。" data-workspace-en="Learning logs come from repytorch; essays live here. Only explicitly published writing is shown.">学习日志来自 repytorch，杂文独立记录。只展示明确发布的文章。</span>
      <a href="/about/" data-workspace-zh="关于我 →" data-workspace-en="About →">关于我 →</a>
    </footer>
  </main>
  <Fragment slot="body-end">
  <script>
  import { matchesWriting, normalizeSearch, readWritingFilters, writingFilterUrl } from "../../lib/writing.mjs";

  const index = document.querySelector<HTMLElement>("[data-writing-index]");
  if (index) {
    const form = index.querySelector<HTMLFormElement>("form")!;
    const search = form.querySelector<HTMLInputElement>("[name=q]")!;
    const category = form.querySelector<HTMLInputElement>("[name=category]")!;
    const tag = form.querySelector<HTMLSelectElement>("[name=tag]")!;
    const results = index.querySelector<HTMLElement>("#writingResults")!;
    const empty = index.querySelector<HTMLElement>("#writingEmpty")!;
    const emptyHint = index.querySelector<HTMLElement>("#writingEmptyHint")!;
    const cards = [...index.querySelectorAll<HTMLElement>("[data-writing-post]")].map((element) => ({
      element,
      category: element.dataset.category!,
      tags: JSON.parse(element.dataset.tags!) as string[],
      searchText: element.dataset.search!,
    }));

    const chinese = () => (document.documentElement.dataset.lang ?? document.documentElement.lang).toLowerCase().startsWith("zh");
    const state = () => ({ q: search.value, category: category.value, tag: tag.value });
    const render = () => {
      const filters = state();
      let count = 0;
      cards.forEach((post) => {
        post.element.hidden = !matchesWriting(post, filters);
        if (!post.element.hidden) count += 1;
      });
      results.textContent = chinese()
        ? `显示 ${count} / ${cards.length} 篇文章`
        : `Showing ${count} of ${cards.length} ${cards.length === 1 ? "article" : "articles"}`;
      empty.hidden = count > 0;
      emptyHint.textContent = filters.category === "essay" && !filters.q && !filters.tag
        ? chinese() ? "这里还没有已发布的杂文。留一些位置，给以后的随想。" : "No published essays yet. Leaving a little room for future thoughts."
        : chinese() ? "换个关键词，或清除分类和标签试试。" : "Try another keyword, or clear the category and tag filters.";
      index.querySelectorAll<HTMLAnchorElement>(".writing-categories [data-writing-category]").forEach((link) => {
        if (link.dataset.writingCategory === filters.category) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });
      index.querySelectorAll<HTMLAnchorElement>("[data-writing-category]").forEach((link) => {
        link.href = writingFilterUrl({ ...filters, category: link.dataset.writingCategory! });
      });
      index.querySelectorAll<HTMLAnchorElement>("[data-writing-tag]").forEach((link) => {
        link.href = writingFilterUrl({ ...filters, tag: link.dataset.writingTag! });
      });
    };
    const setTag = (value: string) => {
      tag.querySelectorAll("[data-transient]").forEach((option) => option.remove());
      const matching = [...tag.options].find((option) => normalizeSearch(option.value) === normalizeSearch(value));
      if (value && !matching) {
        const option = new Option(chinese() ? `${value}（未收录）` : `${value} (not indexed)`, value);
        option.dataset.transient = "true";
        tag.add(option);
      }
      tag.value = matching?.value ?? value;
    };
    const restore = () => {
      const filters = readWritingFilters(location.search);
      search.value = filters.q;
      category.value = filters.category;
      setTag(filters.tag);
      render();
    };
    const update = (mode: "pushState" | "replaceState") => {
      const url = new URL(location.href);
      // Keep unrelated parameters and fragments; only own the three filter keys.
      const next = new URL(writingFilterUrl(state()), url.origin);
      ["q", "category", "tag"].forEach((key) => {
        url.searchParams.delete(key);
        const value = next.searchParams.get(key);
        if (value) url.searchParams.set(key, value);
      });
      if (url.href !== location.href) history[mode](null, "", url);
      render();
    };
    const clear = () => {
      search.value = "";
      category.value = "";
      tag.value = "";
      update("pushState");
    };

    let searchTimer: ReturnType<typeof setTimeout> | undefined;
    search.addEventListener("input", () => {
      render();
      clearTimeout(searchTimer);
      searchTimer = setTimeout(() => update("replaceState"), 200);
    });
    tag.addEventListener("change", () => update("pushState"));
    form.addEventListener("submit", (event) => { event.preventDefault(); update("pushState"); });
    form.addEventListener("reset", (event) => { event.preventDefault(); clearTimeout(searchTimer); clear(); });
    index.querySelector("[data-writing-clear]")!.addEventListener("click", clear);
    index.addEventListener("click", (event) => {
      if (!(event instanceof MouseEvent) || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>("a[data-writing-category], a[data-writing-tag]");
      if (!link) return;
      event.preventDefault();
      clearTimeout(searchTimer);
      if (link.dataset.writingCategory !== undefined) category.value = link.dataset.writingCategory;
      if (link.dataset.writingTag !== undefined) setTag(link.dataset.writingTag);
      update("pushState");
    });
    window.addEventListener("popstate", () => { clearTimeout(searchTimer); restore(); });
    // Translate only the archive interface; authored titles, summaries and filter values stay unchanged.
    window.addEventListener("site:language-change", () => { setTag(tag.value); render(); });
    restore();
    index.querySelectorAll<HTMLElement>("[data-writing-enhanced]").forEach((element) => { element.removeAttribute("inert"); });
  }
  </script>
  </Fragment>
</BaseLayout>
