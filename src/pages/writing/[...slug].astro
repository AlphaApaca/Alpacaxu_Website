---
import { render, type CollectionEntry } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { getPublishedPosts } from "../../lib/content";
import { calculateReadingMetrics } from "../../lib/reading-metrics.mjs";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: { slug: post.data.permalink },
    props: { post }
  }));
}

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const metrics = calculateReadingMetrics(post.body ?? "");
---

<ArticleLayout
  title={post.data.title}
  summary={post.data.summary}
  date={post.data.date}
  category={post.data.category}
  tags={post.data.tags}
  lang={post.data.lang}
  sourceUrl={post.data.sourceUrl}
  sourceCommit={post.data.sourceCommit}
  comments={post.data.comments}
  commentTerm={`/writing/${post.data.permalink}/`}
  headings={headings}
  metrics={metrics}
>
  <Content />
</ArticleLayout>
