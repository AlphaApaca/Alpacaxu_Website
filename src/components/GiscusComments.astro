---
interface Props {
  term: string;
  lang?: string;
  guestbook?: boolean;
}

const { term, lang = "zh-CN", guestbook = false } = Astro.props;
const isChinese = lang.toLowerCase().startsWith("zh");
const title = guestbook ? "留言板" : isChinese ? "评论" : "Discussion";
const description = guestbook
  ? "欢迎留下想法、问题或一句问候。留言公开保存在 GitHub Discussions，发表前需要登录 GitHub。"
  : isChinese
    ? "欢迎交流这篇文章。评论公开保存在 GitHub Discussions，发表前需要登录 GitHub。"
    : "Share a question or thought about this article. Comments are public on GitHub Discussions; a GitHub account is required to post.";
---

<section class="comments-section" aria-labelledby="discussion-heading" data-giscus data-term={term} data-lang={isChinese ? "zh-CN" : "en"}>
  <p class="section-kicker">{guestbook ? "Guestbook" : "Conversation"}</p>
  <h2 id="discussion-heading">{title}</h2>
  <p class="comments-intro">{description}</p>
  <div class="comments-actions">
    <button type="button" class="comments-load">{isChinese ? "加载评论" : "Load comments"}</button>
    <a href="https://github.com/AlphaApaca/Alpacaxu_Website/discussions" target="_blank" rel="noopener noreferrer">
      {isChinese ? "在 GitHub 查看讨论 ↗" : "View discussions on GitHub ↗"}
    </a>
  </div>
  <p class="comments-status" role="status" aria-live="polite"></p>
  <div class="giscus"></div>
  <noscript><p>{isChinese ? "启用 JavaScript 后可加载评论，也可以直接访问上方 GitHub 讨论区。" : "Enable JavaScript to load comments, or open the GitHub discussions link above."}</p></noscript>
</section>

<script>
  const giscusOrigin = "https://giscus.app";

  document.querySelectorAll<HTMLElement>("[data-giscus]").forEach((section) => {
    const button = section.querySelector<HTMLButtonElement>(".comments-load");
    const status = section.querySelector<HTMLElement>(".comments-status");
    const container = section.querySelector<HTMLElement>(".giscus");
    const isChinese = section.dataset.lang === "zh-CN";
    if (!button || !status || !container) return;

    const theme = () => document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    const updateTheme = () => {
      section.querySelector<HTMLIFrameElement>("iframe.giscus-frame")?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: theme() } } },
        giscusOrigin
      );
    };

    new MutationObserver(updateTheme).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"]
    });

    const frameObserver = new MutationObserver(() => {
      const frame = container.querySelector<HTMLIFrameElement>("iframe.giscus-frame");
      if (!frame) return;
      frame.addEventListener("load", () => {
        updateTheme();
        status.textContent = "";
      });
      frameObserver.disconnect();
    });
    frameObserver.observe(container, { childList: true, subtree: true });

    button.addEventListener("click", () => {
      button.disabled = true;
      status.textContent = isChinese ? "正在连接 GitHub 评论区…" : "Connecting to GitHub discussions…";

      const script = document.createElement("script");
      script.src = `${giscusOrigin}/client.js`;
      script.async = true;
      script.crossOrigin = "anonymous";
      const config: Record<string, string> = {
        repo: "AlphaApaca/Alpacaxu_Website",
        "repo-id": "R_kgDOSeCXYQ",
        category: "Announcements",
        "category-id": "DIC_kwDOSeCXYc4DG6Ee",
        mapping: "specific",
        term: section.dataset.term ?? "",
        strict: "1",
        "reactions-enabled": "1",
        "emit-metadata": "0",
        "input-position": "bottom",
        theme: theme(),
        lang: section.dataset.lang ?? "zh-CN",
        loading: "lazy"
      };
      Object.entries(config).forEach(([key, value]) => script.setAttribute(`data-${key}`, value));
      script.addEventListener("load", () => { button.hidden = true; });
      script.addEventListener("error", () => {
        script.remove();
        button.disabled = false;
        status.textContent = isChinese
          ? "评论暂时无法加载，请重试或打开 GitHub 讨论区。"
          : "Comments could not load. Please retry or open GitHub discussions.";
      });
      container.append(script);
    });
  });
</script>
